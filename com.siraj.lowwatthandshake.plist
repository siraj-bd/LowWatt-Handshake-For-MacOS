<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.siraj.lowwatthandshake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/LowWatt Handshake macOS.app/Contents/MacOS/LowWatt Handshake macOS</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/lowwatt-handshake.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/lowwatt-handshake.err</string>
</dict>
</plist>
